<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bất ngờ chưa!</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 20px;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #1e3c72, #2a5298);
            color: #fff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            overflow-x: hidden;
        }

        .container {
            max-width: 600px;
            width: 100%;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            padding: 30px;
            border-radius: 20px;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
            border: 1px solid rgba(255, 255, 255, 0.18);
        }

        h1 {
            font-size: 1.8rem;
            margin-bottom: 20px;
        }

        .btn-troll {
            padding: 15px 40px;
            font-size: 1.2rem;
            font-weight: bold;
            color: #fff;
            background: #ff4757;
            border: none;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(255, 71, 87, 0.4);
            transition: all 0.3s ease;
            outline: none;
        }

        .btn-troll:hover {
            transform: scale(1.05);
            background: #ff6b81;
        }

        .btn-troll:active {
            transform: scale(0.95);
        }

        .sensor-panel {
            margin-top: 25px;
            display: none;
            text-align: left;
            background: rgba(0, 0, 0, 0.5);
            padding: 20px;
            border-radius: 12px;
            font-family: monospace;
            font-size: 0.9rem;
        }

        .sensor-item {
            margin-bottom: 10px;
            padding-bottom: 8px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.15);
            word-break: break-word;
        }

        /* Hiệu ứng rung màn hình khi bị troll */
        .active-troll {
            animation: shake 0.2s infinite;
        }

        @keyframes shake {
            0% { transform: translate(1px, 1px) rotate(0deg); }
            20% { transform: translate(-2px, 0px) rotate(1deg); }
            40% { transform: translate(1px, -1px) rotate(1deg); }
            60% { transform: translate(-2px, 1px) rotate(0deg); }
            80% { transform: translate(-1px, -1px) rotate(1deg); }
            100% { transform: translate(1px, -2px) rotate(-1deg); }
        }
    </style>
</head>
<body>

    <div class="container" id="mainContainer">
        <h1 id="titleText">🎁 Bấm vào đây để nhận món quà bí mật! 🎁</h1>
        <button class="btn-troll" id="trollBtn" onclick="startTroll()">MỞ QUÀ NGAY</button>

        <div class="sensor-panel" id="sensorPanel">
            <h2 style="color: #ff4757; text-align: center; margin-top: 0;">⚠️ ĐÃ KÍCH HOẠT QUÉT CẢM BIẾN ⚠️</h2>
            <div id="sensorList"></div>
        </div>
    </div>

    <script>
        let isTrolling = false;

        // Hàm phát âm thanh tiếng cười vui nhộn sử dụng Web Audio API
        function playLaughSound() {
            try {
                const AudioContext = window.AudioContext || window.webkitAudioContext;
                if (!AudioContext) return;
                
                const audioCtx = new AudioContext();
                const laughPitches = [350, 550, 300, 600, 350, 650, 280, 500];
                let time = audioCtx.currentTime;

                laughPitches.forEach((freq, index) => {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(freq, time + index * 0.1);
                    
                    gain.gain.setValueAtTime(0.3, time + index * 0.1);
                    gain.gain.exponentialRampToValueAtTime(0.01, time + (index + 1) * 0.1);
                    
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    
                    osc.start(time + index * 0.1);
                    osc.stop(time + (index + 1) * 0.1);
                });
            } catch (e) {
                console.log("Audio Error:", e);
            }
        }

        function startTroll() {
            if (isTrolling) return;
            isTrolling = true;

            // Hiệu ứng giao diện
            document.body.classList.add('active-troll');
            document.getElementById('titleText').innerText = "🤣 BẠN ĐÃ BỊ TROLL! 🤣";
            document.getElementById('trollBtn').style.display = 'none';
            document.getElementById('sensorPanel').style.display = 'block';

            // Phát tiếng cười liên tục mỗi 1 giây
            playLaughSound();
            setInterval(playLaughSound, 1000);

            // Rung thiết bị (dành cho điện thoại Android/iOS hỗ trợ)
            if ("vibrate" in navigator) {
                navigator.vibrate([200, 100, 200, 100, 400]);
            }

            // Tiến hành đọc & liệt kê toàn bộ cảm biến
            initSensors();
        }

        // Hàm khởi tạo và theo dõi tất cả cảm biến trên thiết bị
        function initSensors() {
            const list = document.getElementById('sensorList');

            function updateSensorInfo(id, name, value) {
                let el = document.getElementById('sensor-' + id);
                if (!el) {
                    el = document.createElement('div');
                    el.id = 'sensor-' + id;
                    el.className = 'sensor-item';
                    list.appendChild(el);
                }
                el.innerHTML = `<strong style="color: #4bcffa;">${name}:</strong> ${value}`;
            }

            // 1. Cảm biến nghiêng thiết bị (Device Orientation)
            if (window.DeviceOrientationEvent) {
                window.addEventListener('deviceorientation', (e) => {
                    updateSensorInfo('orientation', 'Cảm biến xoay (Orientation)', 
                        `Alpha: ${Math.round(e.alpha || 0)}°, Beta: ${Math.round(e.beta || 0)}°, Gamma: ${Math.round(e.gamma || 0)}°`);
                });
            } else {
                updateSensorInfo('orientation', 'Cảm biến xoay', 'Không hỗ trợ');
            }

            // 2. Cảm biến gia tốc & Chuyển động (Accelerometer / Gyroscope)
            if (window.DeviceMotionEvent) {
                window.addEventListener('devicemotion', (e) => {
                    const acc = e.accelerationIncludingGravity || {x: 0, y: 0, z: 0};
                    updateSensorInfo('motion', 'Gia tốc kế (Accelerometer)', 
                        `X: ${acc.x ? acc.x.toFixed(2) : 0}, Y: ${acc.y ? acc.y.toFixed(2) : 0}, Z: ${acc.z ? acc.z.toFixed(2) : 0}`);
                });
            } else {
                updateSensorInfo('motion', 'Gia tốc kế', 'Không hỗ trợ');
            }

            // 3. Cảm biến ánh sáng (Ambient Light Sensor API - Chrome/Android)
            if ('AmbientLightSensor' in window) {
                try {
                    const sensor = new AmbientLightSensor();
                    sensor.onreading = () => {
                        updateSensorInfo('light', 'Cảm biến ánh sáng', `${sensor.illuminance} lux`);
                    };
                    sensor.start();
                } catch (err) {
                    updateSensorInfo('light', 'Cảm biến ánh sáng', 'Cần cấp quyền truy cập');
                }
            } else {
                updateSensorInfo('light', 'Cảm biến ánh sáng', 'Không hỗ trợ trên trình duyệt này');
            }

            // 4. Màn hình & Góc quay
            updateSensorInfo('screen', 'Độ phân giải màn hình', 
                `${window.screen.width} x ${window.screen.height} (Độ xoay: ${window.screen.orientation ? window.screen.orientation.angle : 0}°)`);

            // 5. Cảm biến lực / Số điểm cảm ứng tối đa
            updateSensorInfo('touch', 'Điểm cảm ứng đồng thời', 
                `${navigator.maxTouchPoints || 1} điểm`);

            // 6. Trạng thái pin (Battery Status API)
            if (navigator.getBattery) {
                navigator.getBattery().then(battery => {
                    const updateBattery = () => {
                        updateSensorInfo('battery', 'Thông tin Pin', 
                            `${Math.round(battery.level * 100)}% (${battery.charging ? 'Đang sạc ⚡' : 'Không sạc'})`);
                    };
                    updateBattery();
                    battery.addEventListener('levelchange', updateBattery);
                    battery.addEventListener('chargingchange', updateBattery);
                });
            } else {
                updateSensorInfo('battery', 'Thông tin Pin', 'Không hỗ trợ API');
            }
        }
    </script>
</body>
</html>
